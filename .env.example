# Copy to .env.local (git-ignored). Leave the Supabase values empty to run the local demo.

# --- Frontend (bundled into the public site; these are safe to expose) ---
# Supabase project URL and the *anon* public key (Project Settings → API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# GitHub Pages project-site path, used by `npm run build:pages`. Must match the repo name.
VITE_BASE_PATH=/hatchery-electronics-library/

# --- Local demo only (read by the Vite dev server in Node; never bundled) ---
# Lets "Suggest details from photo" work in the local demo. Leave empty to test manual entry.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# Set to true to simulate the AI being down even when a key is present.
AI_DISABLED=false

# --- Never put these in this file or any VITE_ variable ---
# SUPABASE_SERVICE_ROLE_KEY  (not needed by this app at all)
# Production OPENROUTER_API_KEY goes in Supabase function secrets:
#   npx supabase secrets set OPENROUTER_API_KEY=... OPENROUTER_MODEL=google/gemini-2.5-flash
